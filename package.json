{
  "name": "coincontrol",
  "private": true,
  "version": "0.1.1",
  "description": "Portfolio Desk: personal read-only crypto portfolio tracker (Tauri 2 + React + Rust + SQLite).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "gen:bindings": "node scripts/gen-bindings.mjs",
    "check": "node scripts/check.mjs",
    "test:offline": "node scripts/test-offline.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:e2e:windows": "node scripts/test-e2e-windows.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "build:windows": "tauri build --bundles nsis",
    "verify:release": "node scripts/verify-release.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "echarts": "^6.1.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
