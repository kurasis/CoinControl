{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window. Only the listed application commands are reachable; no shell, filesystem, HTTP or arbitrary SQL plugins are enabled. External links open in the system browser only for allow-listed provider documentation and block explorer hosts.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "allow-app-info",
    "allow-switch-profile",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-networks",
    "allow-validate-address",
    "allow-create-wallet",
    "allow-list-wallets",
    "allow-rename-wallet",
    "allow-add-account",
    "allow-list-accounts",
    "allow-set-account-archived",
    "allow-move-account",
    "allow-create-group",
    "allow-list-groups",
    "allow-set-group-wallets",
    "allow-delete-group",
    "allow-list-holdings",
    "allow-get-portfolio-summary",
    "allow-get-chart",
    "allow-list-activity",
    "allow-get-asset-detail",
    "allow-get-asset-chart",
    "allow-list-review-items",
    "allow-get-leg-detail",
    "allow-update-basis",
    "allow-preview-basis-import",
    "allow-commit-basis-import",
    "allow-discard-basis-import",
    "allow-replay-accounting",
    "allow-list-providers",
    "allow-save-provider-key",
    "allow-remove-provider-key",
    "allow-sync-now",
    "allow-list-sync-status",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://livecoinwatch.github.io/*"
        },
        {
          "url": "https://www.livecoinwatch.com/*"
        },
        {
          "url": "https://developers.zerion.io/*"
        },
        {
          "url": "https://dashboard.zerion.io/*"
        },
        {
          "url": "https://github.com/Blockstream/esplora/*"
        },
        {
          "url": "https://developers.tron.network/*"
        },
        {
          "url": "https://www.trongrid.io/*"
        },
        {
          "url": "https://docs.tonapi.io/*"
        },
        {
          "url": "https://tonconsole.com/*"
        },
        {
          "url": "https://api-docs.defillama.com/*"
        },
        {
          "url": "https://www.helius.dev/*"
        },
        {
          "url": "https://dashboard.helius.dev/*"
        },
        {
          "url": "https://www.alchemy.com/*"
        },
        {
          "url": "https://dashboard.alchemy.com/*"
        },
        {
          "url": "https://www.ankr.com/*"
        },
        {
          "url": "https://mempool.space/*"
        },
        {
          "url": "https://etherscan.io/*"
        },
        {
          "url": "https://basescan.org/*"
        },
        {
          "url": "https://arbiscan.io/*"
        },
        {
          "url": "https://optimistic.etherscan.io/*"
        },
        {
          "url": "https://polygonscan.com/*"
        },
        {
          "url": "https://bscscan.com/*"
        },
        {
          "url": "https://solscan.io/*"
        },
        {
          "url": "https://tronscan.org/*"
        },
        {
          "url": "https://tonviewer.com/*"
        }
      ]
    }
  ]
}
