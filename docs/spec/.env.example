# DEVELOPMENT / TEST TEMPLATE ONLY. No real credentials belong in this file.
# Copy privately to .env.test.local; explicitly load it in the Rust test launcher.
# Production reads user-entered credentials from the OS secret store.
LIVECOINWATCH_API_KEY=
ZERION_API_KEY=
TRONGRID_API_KEY=
TONAPI_API_KEY=
# Optional supplemental providers; leave blank unless enabled.
HELIUS_API_KEY=
ALCHEMY_API_KEY=
ANKR_API_TOKEN=

# Live reads require explicit opt-in and provider selection.
RUN_LIVE_API_TESTS=0
LIVE_TEST_PROVIDERS=
LIVE_TEST_MAX_REQUESTS_PER_PROVIDER=50
LIVE_TEST_MAX_HELIUS_CREDITS=5000
LIVE_TEST_MAX_ALCHEMY_CU=10000
LIVE_TEST_MAX_ANKR_CREDITS=50000
# Use a committed, independently verified public target manifest in implementation.
LIVE_TEST_TARGETS_FILE=tests/live/public-targets.json
# Tests must use an isolated profile, never the real user's application database.
TEST_PROFILE_NAME=integration-test

# Independent reserves; Chainstack expects a Solana node auth token or HTTPS endpoint.
BLOCKSCOUT_API_KEY=
DRPC_API_KEY=
CHAINSTACK_API_KEY=
TONCENTER_API_KEY=
ETHERSCAN_API_KEY=
